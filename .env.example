# Landroof configuration — copy this file to .env and fill in your values.
# .env is ignored by git; never commit real passwords.
# In production (NODE_ENV=production) the server REFUSES TO START with a weak ADMIN_PASS or no JWT_SECRET.

# Port the web server listens on
PORT=3000

# Admin panel login. At least 12 characters with letters and numbers; the default is rejected in production.
ADMIN_USER=admin
ADMIN_PASS=

# Optional 2-step login for the admin panel. Run `npm run admin:2fa` and paste the secret here.
# ADMIN_TOTP_SECRET=

# Secret used to sign JWT login tokens — at least 32 characters. REQUIRED when NODE_ENV=production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development it can be left empty: a secret is generated and saved to data/.jwt-secret.
# Changing it signs everyone out.
JWT_SECRET=

# Optional token lifetimes
# ACCESS_TOKEN_TTL=15m
# ADMIN_REFRESH_HOURS=12
# USER_REFRESH_DAYS=30

# Public address of the site (no trailing slash). Use https:// on a live site.
# Used for SEO links, the sitemap, social previews and links in emails.
SITE_URL=http://localhost:3000

# Outgoing email for account confirmation and password reset.
# Without SMTP_HOST, emails are saved as .html files in data/outbox instead of being sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0          # 1 for port 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Landroof <no-reply@yourdomain.com>
# Admin notifications (new listing requests, listings waiting for review). Empty = the contact email from Site Numbers.
# ADMIN_EMAIL=you@yourdomain.com

# Database file and image upload folder (created automatically)
DB_PATH=./data/landroof.db
UPLOAD_DIR=./public/uploads

# Personal-data retention: leads are deleted after LEAD_RETENTION_DAYS; IP address and browser
# details are blanked after IP_RETENTION_DAYS.
# LEAD_RETENTION_DAYS=730
# IP_RETENTION_DAYS=90

# Set to production on a live server (caches pages, Secure cookies, HSTS, strict config checks)
NODE_ENV=development

# Set to 1 ONLY when running behind nginx / a load balancer, so visitor IPs (used for rate
# limiting) are read correctly. Leaving it at 1 without a proxy lets clients fake their IP.
TRUST_PROXY=0

# Optional: other websites allowed to call the public API, comma-separated
# CORS_ORIGINS=https://partner.example.com
